<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Forget Password'); ?>
<?php $this->startSection('content'); ?>
<div class="w-full bg-white p-5">
 <div class="flex justify-between items-center pb-2">
 <h1 class="text-4xl font-bold text-blue-950">Lupa Password</h1>
 </div>
 <hr>
 <div>
 <table class="w-full mt-2 text-center border">
 <thead>
 <tr class="border">
 <th scope="col" class="px-6 py-3">Credential ID</th>
 <th scope="col" class="px-6 py-3">Nama</th>
 <th scope="col" class="px-6 py-3">Role</th>
 <th scope="col" class="px-6 py-3">Nomor</th>
 <th scope="col" class="px-6 py-3">Status</th>
 <th scope="col" class="px-6 py-3">Aksi</th>
 </tr>
 </thead>
 <tbody>
 <?php $__empty_1 = true; foreach($forgetpass as $f ): $__empty_1 = false; ?>
 <tr>
 <td class="px-6 py-4"><?php echo \htmlentities($f->credential??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="px-6 py-4"><?php echo \htmlentities($f->nama??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="px-6 py-4"><?php echo \htmlentities($f->role??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="px-6 py-4"><?php echo \htmlentities($f->nomor??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="px-6 py-4"><?php echo \htmlentities($f->status??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="px-6 py-4 flex gap-x-3 justify-center">
 <?php if($f->status === 'pending'): ?>
 <form action="/forget-pass/update/<?php echo \htmlentities($f->id??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST">
 <input type='hidden' name='<?php  echo '_token'; ?>' value='<?php echo $this->csrf_token; ?>'/>
 <button type="submit" class="bg-green-600 text-white px-3 py-2 rounded-md">Selesaikan</button>
 </form>
 <?php elseif($f->status === 'selesai'): ?>
 <form action="/forget-pass/update/<?php echo \htmlentities($f->id??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST">
 <input type='hidden' name='<?php  echo '_token'; ?>' value='<?php echo $this->csrf_token; ?>'/>
 <button type="submit" class="bg-yellow-500 text-white px-3 py-2 rounded-md">Batalkan</button>
 </form>
 <?php endif; ?>
 <form action="/forget-pass/delete/<?php echo \htmlentities($f->id??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST">
 <input type='hidden' name='<?php  echo '_token'; ?>' value='<?php echo $this->csrf_token; ?>'/>
 <input type='hidden' name='_method' value='<?php echo 'DELETE'; ?>'/>
 <button type="submit" class="bg-red-500 text-white px-3 py-2 rounded-md">Delete</button>
 </form>
 </td>
 </tr>
 <?php endforeach; if ($__empty_1): ?>
 <tr>
 <td colspan="6" class="text-center">Data tidak ditemukan</td>
 </tr>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.DashboardLayout'); } ?>