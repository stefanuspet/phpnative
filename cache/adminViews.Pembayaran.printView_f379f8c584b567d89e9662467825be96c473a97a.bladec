<html>

<head>
 <style>
 body {
 font-family: Arial, sans-serif;
 font-size: 12px;
 }

 table {
 width: 100%;
 border-collapse: collapse;
 }

 th,
 td {
 padding: 8px;
 border: 1px solid #000;
 text-align: center;
 }

 th {
 background-color: #f2f2f2;
 }

 .table-title {
 text-align: center;
 font-size: 16px;
 margin-bottom: 20px;
 }
 </style>
</head>

<body>
 <div class="table-title">Laporan Pembayaran</div>
 <table>
 <thead>
 <tr>
 <th>Dojo Asal</th>
 <th>Nama</th>
 <th>Tanggal Bukti Diunggah</th>
 <th>Pembayaran Bulan</th>
 <th>Nominal</th>
 <th>Foto Bukti</th>
 <th>Catatan Admin</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $pembayaran; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $items): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($items->anggota->dojo->nama??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($items->anggota->nama??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities(\Carbon\Carbon::parse($items->created_at)->format('d-m-Y')??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($items->bulan??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>Rp <?php echo \htmlentities($items->nominal??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php 
 $path = $_SERVER['DOCUMENT_ROOT'] . '/uploads/' . $items->bukti_pembayaran;
 $type = pathinfo($path, PATHINFO_EXTENSION);
 $data = file_get_contents($path);
 $base64 = 'data:image/' . $type . ';base64,' . base64_encode($data);
 ?>
 <img src="<?php echo \htmlentities($base64??'', ENT_QUOTES, 'UTF-8', false); ?>" width="50" alt="Bukti Pembayaran">
 </td>

 <td><?php echo \htmlentities($items->catatan??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
</body>

</html>