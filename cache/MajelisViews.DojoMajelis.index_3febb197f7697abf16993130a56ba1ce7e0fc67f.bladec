 </form>
 </div>
 </td>
 </tr>

 <?php 
 $previousDojoId = $dj->dojo->id; // Update the previous dojo ID
 $previousDayTime = $currentDayTime; // Update the previous day and time combination
 ?>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
