<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Perlengkapan-Edit'); ?>
<?php $this->startSection('content'); ?>
<div class="w-full">
 <h1 class="text-4xl font-bold pb-10 text-blue-950">Edit Perlengkapan</h1>
 <div class="shadow-md rounded-md bg-white w-4/5">
 <form action="/dashboard/perlengkapan/update/<?php echo \htmlentities($perlengkapan->id??'', ENT_QUOTES, 'UTF-8', false); ?>" class="p-4" method="post" enctype="multipart/form-data">
 <input type='hidden' name='<?php  echo '_token'; ?>' value='<?php echo $this->csrf_token; ?>'/>
 <input type='hidden' name='_method' value='<?php echo 'PUT'; ?>'/>
 <div class="mb-3">
 <label for="nama" class="block">Nama Perlengkapan</label>
 <input type="text" name="nama" id="nama" class="w-full border border-blue-600 rounded-md p-2" value="<?php echo \htmlentities($perlengkapan->nama??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>
 <div class="mb-3">
 <label for="ukuran" class="block">Ukuran</label>
 <select name="ukuran" id="ukuran" class="w-full border border-blue-600 rounded-md p-2" required>
 <option value="">Choose</option>
 <option value="M" <?php echo \htmlentities($perlengkapan->ukuran == 'M' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>M</option>
 <option value="L" <?php echo \htmlentities($perlengkapan->ukuran == 'L' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>L</option>
 <option value="XL" <?php echo \htmlentities($perlengkapan->ukuran == 'XL' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>XL</option>
 </select>
 </div>
 <div class="mb-3">
 <label for="jumlah" class="block">Jumlah</label>
 <input type="number" name="jumlah" id="jumlah" class="w-full border border-blue-600 rounded-md p-2" value="<?php echo \htmlentities($perlengkapan->jumlah??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>
 <div class="mb-3">
 <label for="status" class="block">Status</label>
 <input type="text" name="status" id="status" class="w-full border border-blue-600 rounded-md p-2" value="<?php echo \htmlentities($perlengkapan->status??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>
 <div class="mb-3">
 <label for="foto" class="block">Foto</label>
 <input type="file" name="foto" id="foto" class="w-full border border-blue-600 rounded-md p-2" accept="image/*">
 <?php if($perlengkapan->foto): ?>
 <div class="mt-3">
 <img src="/uploads/<?php echo \htmlentities($perlengkapan->foto??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="Foto Perlengkapan" class="w-32 h-32 object-cover rounded-md">
 </div>
 <?php endif; ?>
 </div>
 <div class="flex justify-end mt-10">
 <button class="px-3 py-1 bg-green-600 rounded-md text-white">Simpan</button>
 </div>
 </form>
 </div>
</div>
</div>


<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.DashboardLayout'); } ?>